#
# This is the lazy-mise list: everything you install "full-fat" but only reach
# for occasionally. A `lazy = true` tool costs nothing at bootstrap — mise
# publishes a bootstrap shim for it and installs the real thing the first time
# you run one of its commands. A bare `mise install` skips these;
# `mise install --include-lazy` fetches all of them.
#
# To warm a machine in the background instead of paying on first use:
#   mise install --include-lazy --jobs 8 & disown   (or `mise run warm-tools`)
#
# Skipped here: names 10-core.toml declares eagerly, names
# .chezmoitemplates/mise/eager-tools blocks from ever being lazy, and names
# .chezmoitemplates/mise/declared says config.toml already owns — mise merges
# `[tools]` per tool and the higher-precedence file wins, so a duplicate would
# only make `mise ls` confusing.

[tools]
{{- $coreFiles := (list "pacfile-core" "yayfile-core" "aptfile-core" "crates-core.txt" "npm_globals") -}}
{{- $fullFiles := (list "pacfile-full" "yayfile-full" "aptfile-full" "crates-full.txt" "Brewfile") -}}
{{- $entries := (list
      (dict "file" "pacfile-full"    "prefix" "")
      (dict "file" "yayfile-full"    "prefix" "")
      (dict "file" "aptfile-full"    "prefix" "")
      (dict "file" "crates-full.txt" "prefix" "cargo:" "depends" (list "rust"))
      (dict "file" "Brewfile"        "prefix" "")) -}}
{{- $ported := includeTemplate "mise/names" (dict "mode" "ported" "files" $fullFiles) -}}
{{- $skip := list -}}
{{- $fromCore := includeTemplate "mise/names" (dict "mode" "ported" "files" $coreFiles) -}}
{{- if $fromCore -}}{{ $skip = append $skip $fromCore }}{{ end -}}
{{- $promoted := includeTemplate "mise/names" (dict "mode" "eager" "files" $fullFiles) -}}
{{- if $promoted -}}{{ $skip = append $skip $promoted }}{{ end -}}
{{- $already := includeTemplate "mise/names" (dict "mode" "declared") -}}
{{- if $already -}}{{ $skip = append $skip $already }}{{ end -}}
{{- $never := join "\n" $skip -}}
{{- if $ported }}
{{ includeTemplate "mise/tools" (dict "lazy" true "only" $ported "skip" $never "entries" $entries) }}
{{- else }}
# nothing ported yet — seed .chezmoitemplates/mise/mise-tools
{{- end }}
