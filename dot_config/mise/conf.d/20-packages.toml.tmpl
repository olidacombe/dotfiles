# Inputs: every *-core / *-full list file EXCEPT crates-*.txt and npm_globals,
#         minus the entries .chezmoitemplates/mise/mise-tools hands to mise.
#
# `[bootstrap.packages]` is machine-wide software: mise installs it with the host
# package manager (`pacman`, `aur` via yay/paru, `apt`, `brew`, `brew-cask`, …),
# never per-project, and never with a shim. Nothing here is lazy — this is the
# bulk of what makes bootstrap.sh slow, which is why it is kept separate: when
# you are ready, `mise bootstrap packages apply` replaces the pacman/yay/apt/brew
# blocks, and the `os` option means darwin and linux entries skip each other.
#
# Not ported on purpose: mise itself (bootstrap installs it first — lazy shims
# need mise ≥ 2026.9.0), the login shell (zsh), anything another package builds
# against (base-devel, cmake, ninja, …), services (sddm, mpd, tailscale, …),
# fonts and GUI apps.

[bootstrap.packages]
{{- $coreFiles := (list "pacfile-core" "yayfile-core" "aptfile-core") -}}
{{- $allFiles := (concat $coreFiles (list "pacfile-full" "yayfile-full" "aptfile-full" "Brewfile")) -}}
{{- $native := includeTemplate "mise/names" (dict "mode" "native" "files" $allFiles) -}}
{{- if $native }}
{{ includeTemplate "mise/packages" (dict
     "only" $native
     "spec" (list
       (dict "file" "pacfile-core" "manager" "pacman" "os" (list "linux"))
       (dict "file" "pacfile-full" "manager" "pacman" "os" (list "linux"))
       (dict "file" "aptfile-core" "manager" "apt" "os" (list "linux"))
       (dict "file" "aptfile-full" "manager" "apt" "os" (list "linux"))
       (dict "file" "yayfile-core" "manager" "aur" "os" (list "linux"))
       (dict "file" "yayfile-full" "manager" "aur" "os" (list "linux"))
       (dict "file" "Brewfile" "manager" "brew" "os" (list "darwin"))
       (dict "file" "Brewfile" "manager" "brew-cask" "os" (list "darwin") "casks" true))) }}
{{- else }}
# everything in the list files is ported to [tools]
{{- end }}
