#!/usr/bin/env zsh

set -euo pipefail

if [ -z "${TMUX+x}" ]; then
    echo Not in tmux
    exit 1
fi

STACK="${HOME}/.local/tpoon"

# make sure our stack exists
touch "$STACK"

function get_current_session() {
    tmux ls | grep '(attached)$' | awk -F: '{ print $1 }' || true
}

# boot any non-existent sessions off the stack
function clean_stack() {
    declare -A SESSION_SET
    tmux ls | awk -F: '{ print $1 }' | while read -r session; do
        SESSION_SET[$session]="$session"
    done
    while read -r session; do
        if [ -n "${SESSION_SET[$session]+x}" ]; then
            echo "$session"
        fi
    done < "$STACK" | awk '!seen[$0]++' | sponge "$STACK"
}

clean_stack

# NOTE: more than one session can be attached at once (e.g. a second
# machine attached to another session), so get_current_session may return
# multiple lines. Push and dedupe each line individually.
function push() {
    local new session found
    get_current_session | while read -r new; do
        found=0
        while read -r session; do
            if [[ "$session" == "$new" ]]; then
                found=1
                break
            fi
        done < "$STACK"
        if (( found )); then
            continue
        fi
        echo "$new" >> "$STACK"
    done
}

function switch() {
    local IDX="$1"
    local SESSION_NAME="$(
        sed "${IDX}q;d" "$STACK"
    )"
    [[ -z "$SESSION_NAME" ]] && return
    tmux switch-client -t "$SESSION_NAME"
}

case "$1" in
    push)
        push;;
    edit)
        # "$EDITOR" "$STACK";;
        nvim -c Tpoon;;
    *)
        switch "$1";;
esac
